# ═══════════════════════════════════════════════════════════════════════
#  Secretos de las Edge Functions (hoy: `invitar-usuario`)
#
#  EN LOCAL: copia este archivo a `supabase/functions/.env` (no se sube al
#  repo). `npx supabase start` y `npx supabase functions serve` lo cargan.
#
#  EN EL PROYECTO REAL: no se usa este archivo. Se cargan con
#    npx supabase secrets set REGB_SITE_URL=https://erp.tu-dominio.do
#  o en el panel: Edge Functions → Secrets.
#
#  SUPABASE_URL y las claves (SUPABASE_PUBLISHABLE_KEYS / SUPABASE_SECRET_KEYS,
#  o las antiguas SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY) las pone
#  Supabase SOLO en cada función: no se escriben en ningún lado. Supabase no
#  deja crear secretos que empiecen por SUPABASE_.
# ═══════════════════════════════════════════════════════════════════════

# Dirección de la web. Con ella se arma el enlace del correo de invitación
# (<REGB_SITE_URL>/auth/invitacion/<token>). Tiene que estar también en
# Authentication → URL Configuration → Redirect URLs.
# En local, la web es http://localhost:3100.
REGB_SITE_URL=http://localhost:3100
