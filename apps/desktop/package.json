{
  "name": "@regb/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "REGB ERP para mostrador: impresion directa, gaveta de efectivo y ventas sin conexion.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && electron dist/main.js",
    "start": "electron dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
