# ═══════════════════════════════════════════════════════════════════════
#  apps/web — variables de la WEB (Next.js)
#
#  En Vercel: Project Settings → Environment Variables (las mismas, una a
#  una). En tu PC: copia este archivo a `apps/web/.env.local`.
#
#  OJO: con NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_ANON_KEY puestas,
#  la web deja el MODO DEMOSTRACIÓN y exige iniciar sesión. Si quieres la
#  demo en local, deja esas dos vacías (o no crees el archivo).
#
#  Referencia completa y de dónde sale cada valor: `.env.example` de la raíz
#  y docs/SUPABASE.md.
# ═══════════════════════════════════════════════════════════════════════

# OBLIGATORIA (inicio de sesión real). Supabase → «Connect» o
# Project Settings → Data API → Project URL.  https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# OBLIGATORIA (inicio de sesión real). Supabase → Project Settings → API Keys →
# «Publishable key» (sb_publishable_…). La antigua «anon» también sirve.
# Es pública a propósito: va al navegador. La secreta NUNCA va aquí.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OBLIGATORIA. Postgres de Supabase para el servidor de Next.
# «Connect» → Connection string → «Transaction pooler» (puerto 6543) en Vercel;
# «Session pooler» (5432) en un servidor propio siempre encendido.
# Cambia [YOUR-PASSWORD] por la contraseña de la base.
DATABASE_URL=

# OBLIGATORIA en producción. Secreto de /api/eventos/despachar, /api/alertas y
# /api/salud. Lo inventas tú:  openssl rand -hex 32
REGB_CRON_SECRET=

# En Vercel, el MISMO valor que REGB_CRON_SECRET: Vercel Cron lo manda solo.
CRON_SECRET=

# Opcional. Webhook de Discord/Slack para las alertas de la mañana.
ALERTAS_WEBHOOK=

# Opcional. Solo si sirves la web desde VARIOS servidores propios a la vez
# (en Vercel no hace falta):  openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Opcional. Si falta, instrumentation.ts usa America/Santo_Domingo.
TZ=America/Santo_Domingo
