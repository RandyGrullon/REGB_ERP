# ═══════════════════════════════════════════════════════════════════════
#  apps/mobile — variables de la app móvil (Expo)
#
#  Copia este archivo a `apps/mobile/.env.local`. Expo lee las variables
#  EXPO_PUBLIC_* al arrancar (`npx expo start`) y app.config.js las pasa a la
#  app. Van DENTRO de la app que se instala: solo pueden ser valores públicos.
# ═══════════════════════════════════════════════════════════════════════

# La misma URL del proyecto que usa la web (NEXT_PUBLIC_SUPABASE_URL).
# Supabase → «Connect» o Project Settings → Data API → Project URL.
# Con el Supabase local, en un teléfono NO sirve 127.0.0.1: usa la IP de tu PC
# en la red (p. ej. http://192.168.1.20:54321).
EXPO_PUBLIC_SUPABASE_URL=

# La misma clave pública que usa la web (NEXT_PUBLIC_SUPABASE_ANON_KEY):
# Project Settings → API Keys → «Publishable key» (sb_publishable_…).
# La clave secreta NUNCA va aquí: la app se puede desarmar y leer.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
