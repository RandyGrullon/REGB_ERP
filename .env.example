# ═══════════════════════════════════════════════════════════════════════
#  REGB ERP — variables de entorno (TODAS, con de dónde sale cada una)
#
#  Este archivo es la referencia. Se copia a:
#   · `.env.local` de la RAÍZ  → lo leen los scripts `pnpm db:*`, `pnpm alertas`,
#     `pnpm despachar` (scripts/entorno.mjs). Next NO lo lee: llenarlo no
#     saca a la web del modo demostración.
#   · `apps/web/.env.local`    → lo lee la web (ver apps/web/.env.example).
#     Con las dos NEXT_PUBLIC_* puestas, la web deja el modo demostración.
#   · Vercel → Project Settings → Environment Variables (la web en producción).
#
#  Ningún `.env.local` se sube al repo (.gitignore). Guía paso a paso:
#  docs/SUPABASE.md.
#
#  Las claves de Supabase son del formato NUEVO: `sb_publishable_…` (pública)
#  y `sb_secret_…` (secreta). Las antiguas (JWT `eyJ…` "anon" y
#  "service_role") también funcionan donde se indica.
# ═══════════════════════════════════════════════════════════════════════

# ── Supabase: la web y el navegador ─────────────────────────────────────

# URL del proyecto. OBLIGATORIA para el inicio de sesión real.
# De dónde: panel de Supabase → botón «Connect» (arriba), o
#   Project Settings → Data API → Project URL. Forma: https://<ref>.supabase.co
# En local (`npx supabase start`): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Clave PÚBLICA (publishable). OBLIGATORIA para el inicio de sesión real.
# De dónde: Project Settings → API Keys → «Publishable key» (sb_publishable_…).
#   También sirve la antigua «anon» (Legacy API Keys). Es pública a propósito:
#   va al navegador y al móvil; lo que protege los datos es la RLS.
# En local: la imprime `npx supabase start` (PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Base de datos ───────────────────────────────────────────────────────

# Conexión de la APP a Postgres. OBLIGATORIA. Es la llave más valiosa del
# sistema: conecta como `postgres`. Solo en el servidor (nunca NEXT_PUBLIC_).
# De dónde: botón «Connect» → Connection string →
#   · Vercel (serverless): «Transaction pooler», puerto 6543.
#     postgresql://postgres.<ref>:<CLAVE>@aws-<n>-us-east-1.pooler.supabase.com:6543/postgres
#   · Servidor propio siempre encendido: «Session pooler», puerto 5432.
#   La app ya usa `prepare: false`, que es lo que exige el Transaction pooler.
#   <CLAVE> es la contraseña de la base (Project Settings → Database →
#   Database password; si no la tienes, «Reset database password»).
# En local, el Postgres de pruebas: postgresql://postgres:postgres@localhost:55432/regb_test
# El Supabase local:                postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/regb_test

# Conexión para MIGRAR, sembrar y respaldar (`pnpm db:*`). Recomendada.
# De dónde: «Connect» → «Session pooler» (puerto 5432), misma contraseña.
# Por qué otra: por el Transaction pooler (6543) no pasan las sentencias
# preparadas que usan los scripts. Si falta, los scripts usan DATABASE_URL (y
# se niegan si es la del 6543).
DATABASE_URL_MIGRACIONES=

# ── Tareas programadas (cron) ───────────────────────────────────────────

# Secreto de las rutas que llama un programador de tareas:
# /api/eventos/despachar, /api/alertas y /api/salud. OBLIGATORIA en producción
# (sin ella esas rutas responden 503 a propósito).
# De dónde: lo inventas tú, largo y al azar:  openssl rand -hex 32
REGB_CRON_SECRET=

# El MISMO valor que REGB_CRON_SECRET, con el nombre que usa Vercel Cron: Vercel
# lo manda solo en `Authorization: Bearer …`. Solo en Vercel.
CRON_SECRET=

# Webhook adonde van las alertas de la mañana (Discord, Slack, Mattermost).
# Opcional: sin él, /api/alertas y `pnpm alertas` solo responden/imprimen.
# De dónde: en Discord, Ajustes del canal → Integraciones → Webhooks → Copiar URL.
ALERTAS_WEBHOOK=

# ── Solo para scripts que corren en TU máquina ──────────────────────────

# URL del ERP que consulta `pnpm alertas` (scripts/alertas.mjs). Opcional.
# Por defecto http://127.0.0.1:3100
BASE=

# URL del ERP que llama `pnpm despachar` (scripts/despachar-cada.mjs), para un
# servidor propio sin Vercel Cron. Opcional. Por defecto http://localhost:3100
REGB_URL=

# Carpeta donde `pnpm db:respaldar` deja los respaldos y donde `pnpm alertas`
# mira si hay uno reciente. Opcional. Por defecto ./respaldos
DIR_RESPALDOS=

# ── Next.js ─────────────────────────────────────────────────────────────

# Clave con la que Next cifra los datos de las server actions. Opcional:
# en Vercel NO hace falta. Solo si sirves la web desde varios servidores
# propios a la vez (todos con la misma). De dónde:  openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Zona horaria del proceso de la web. Opcional: si falta,
# apps/web/src/instrumentation.ts la fija en America/Santo_Domingo al arrancar.
# La BASE se queda en UTC (docs/defi-v1.md §4.12).
TZ=America/Santo_Domingo

# ── Lo que NO va en ningún archivo de este repo ─────────────────────────
#
# · La clave SECRETA de Supabase (sb_secret_…, o la antigua «service_role»):
#   se salta la RLS entera. Solo la usa la Edge Function `invitar-usuario`, y
#   Supabase se la pone sola (SUPABASE_SECRET_KEYS). NUNCA en Vercel, nunca con
#   NEXT_PUBLIC_, nunca en un .env de apps/. `pnpm audit:secrets` rompe el build
#   si aparece en código de cliente.
# · REGB_SITE_URL: es un secreto de la Edge Function, no de la web
#   (supabase/functions/.env.example).
# · La app móvil tiene su propio archivo: apps/mobile/.env.example.
