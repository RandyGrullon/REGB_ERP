{
  "$comment": "Aurora — design system de Nexus ERP. FUENTE UNICA de verdad para web, native y desktop. Documento maestro §11. Nunca escribas un hex fuera de este archivo.",
  "$version": "1.0.0",

  "color": {
    "surface": {
      "deepest": {
        "dark": "#1E1F22",
        "light": "#E3E5E8",
        "use": "Server rail — la barra de empresas"
      },
      "deep": { "dark": "#2B2D31", "light": "#F2F3F5", "use": "Sidebar de modulos" },
      "base": { "dark": "#313338", "light": "#FFFFFF", "use": "Area de contenido principal" },
      "raised": { "dark": "#383A40", "light": "#F8F9FA", "use": "Tarjetas, filas de tabla" },
      "overlay": { "dark": "#404249", "light": "#FFFFFF", "use": "Modales, popovers, hover" },
      "input": { "dark": "#1E1F22", "light": "#EBEDEF", "use": "Campos de formulario" }
    },
    "border": {
      "default": { "dark": "#3F4147", "light": "#E3E5E8", "use": "Separadores" },
      "strong": { "dark": "#4E5058", "light": "#C4C9CE", "use": "Bordes de foco" }
    },
    "brand": {
      "default": {
        "dark": "#5865F2",
        "light": "#5865F2",
        "use": "Blurple — primario, activo, enlaces"
      },
      "hover": { "dark": "#4752C4", "light": "#4752C4", "use": "Hover del primario" },
      "active": { "dark": "#3C45A5", "light": "#3C45A5", "use": "Pressed" },
      "soft": {
        "dark": "rgba(88,101,242,0.15)",
        "light": "rgba(88,101,242,0.10)",
        "use": "Fondo seleccionado"
      },
      "bright": {
        "dark": "#7983F5",
        "light": "#4752C4",
        "use": "Anillo de foco e indicadores. El blurple puro solo da 2.7:1 sobre fondo oscuro: no se ve. Este si."
      }
    },
    "accent": {
      "fuchsia": { "dark": "#EB459E", "light": "#EB459E", "use": "Nexus Control, premium" },
      "teal": { "dark": "#00B0B9", "light": "#009BA3", "use": "IA / Copiloto" }
    },
    "semantic": {
      "$comment": "Color de RELLENO: badges, barras, puntos de estado. Umbral de componente (3:1). Para TEXTO usa semanticText.",
      "success": { "dark": "#23A559", "light": "#1A8245", "use": "Pagado, aprobado, en linea" },
      "warning": { "dark": "#F0B232", "light": "#B8860B", "use": "Por vencer, stock bajo" },
      "danger": { "dark": "#F23F43", "light": "#D02B2F", "use": "Vencido, error, eliminar" },
      "info": { "dark": "#00A8FC", "light": "#0068E0", "use": "Informativo, tips" },
      "neutral": { "dark": "#80848E", "light": "#6D6F78", "use": "Deshabilitado, borrador" }
    },
    "semanticText": {
      "$comment": "Los mismos estados ajustados para leerse como TEXTO: AA 4.5:1 verificado sobre surface.base, .raised y .overlay en ambos temas. Los valores de relleno no llegan (el rojo solo da 2.66:1 sobre fondo oscuro). Calculados, no elegidos a ojo.",
      "success": {
        "dark": "#65C08B",
        "light": "#1A8245",
        "use": "\"Pagado\", \"Aprobado\" como texto"
      },
      "warning": {
        "dark": "#F0B232",
        "light": "#936B09",
        "use": "\"Por vencer\", \"Stock bajo\" como texto"
      },
      "danger": { "dark": "#F89294", "light": "#D02B2F", "use": "\"Vencido\", mensajes de error" },
      "info": { "dark": "#30B9FD", "light": "#0068E0", "use": "Notas y tips" },
      "neutral": {
        "dark": "#ABAEB4",
        "light": "#6D6F78",
        "use": "\"Borrador\", texto deshabilitado"
      }
    },
    "text": {
      "primary": { "dark": "#F2F3F5", "light": "#060607", "use": "Titulos, datos importantes" },
      "secondary": { "dark": "#B5BAC1", "light": "#4E5058", "use": "Cuerpo, etiquetas" },
      "muted": { "dark": "#80848E", "light": "#6D6F78", "use": "Metadatos, placeholders" },
      "link": { "dark": "#00A8FC", "light": "#0068E0", "use": "Enlaces" },
      "onBrand": { "dark": "#FFFFFF", "light": "#FFFFFF", "use": "Texto sobre blurple" }
    },
    "moduleCategory": {
      "core": { "dark": "#23A559", "light": "#1A8245", "use": "Modulos core — incluidos" },
      "standard": { "dark": "#7983F5", "light": "#5865F2", "use": "Modulos estandar" },
      "advanced": { "dark": "#9B59F6", "light": "#8B44E8", "use": "Modulos avanzados" },
      "vertical": { "dark": "#F0883E", "light": "#C26620", "use": "Modulos verticales" },
      "enterprise": { "dark": "#F23F43", "light": "#D02B2F", "use": "Modulos enterprise" },
      "provider": { "dark": "#EB459E", "light": "#EB459E", "use": "Nexus Control" }
    }
  },

  "font": {
    "family": {
      "ui": "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "numeric": "Inter, system-ui, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, 'Cascadia Code', monospace"
    },
    "scale": {
      "display": { "size": 32, "lineHeight": 40, "weight": 700 },
      "h1": { "size": 24, "lineHeight": 32, "weight": 700 },
      "h2": { "size": 20, "lineHeight": 28, "weight": 600 },
      "h3": { "size": 16, "lineHeight": 24, "weight": 600 },
      "body": { "size": 14, "lineHeight": 20, "weight": 400 },
      "bodySm": { "size": 13, "lineHeight": 18, "weight": 400 },
      "caption": { "size": 12, "lineHeight": 16, "weight": 500 },
      "overline": {
        "size": 11,
        "lineHeight": 14,
        "weight": 700,
        "tracking": 0.5,
        "transform": "uppercase"
      }
    }
  },

  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },

  "radius": { "sm": 4, "md": 8, "lg": 12, "xl": 16, "full": 999 },

  "shadow": {
    "sm": "0 1px 2px rgba(0,0,0,0.2)",
    "md": "0 4px 12px rgba(0,0,0,0.3)",
    "lg": "0 8px 24px rgba(0,0,0,0.4)",
    "focus": "0 0 0 3px rgba(88,101,242,0.35)"
  },

  "layout": {
    "serverRail": 72,
    "sidebar": 240,
    "membersPanel": 240,
    "tableRow": 40,
    "touchTarget": 44,
    "headerHeight": 48
  },

  "motion": {
    "duration": { "hover": 100, "page": 150, "modal": 150, "toast": 200, "drawer": 250 },
    "easing": {
      "out": "cubic-bezier(0, 0, 0.2, 1)",
      "inOut": "cubic-bezier(0.4, 0, 0.2, 1)",
      "spring": "cubic-bezier(0.16, 1, 0.3, 1)",
      "drawer": "cubic-bezier(0.32, 0.72, 0, 1)"
    }
  },

  "breakpoint": { "xs": 0, "sm": 480, "md": 768, "lg": 1024, "xl": 1440, "2xl": 1920 }
}
